{
  "scrapkeep-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|edit_file|write_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/safety-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
