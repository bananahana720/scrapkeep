# The control for sitting-profile: on the default launch a new player's second card is locked,
# so pressing 2 starts nothing.
# Launch with: -- --no-intro
until clickable "Settings" 120
until read get_node_or_null("/root/Boot") == null 30
key SPACE
until state class_select 30
tap_until E no_text "FIRST SHIFT" 90
until text "Rivet" 10
wait 1
shot pilot-select-one-open
key 2
wait 4
expect state class_select
shot still-on-pilot-select
quit
