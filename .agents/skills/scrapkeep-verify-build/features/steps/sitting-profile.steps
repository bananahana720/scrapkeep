# The "Scrapkeep sitting" launch: every pilot is open, so the second card starts a run.
# Launch with: -- --no-intro --profile=sitting
until clickable "Settings" 120
until read get_node_or_null("/root/Boot") == null 30
shot title
key SPACE
until state class_select 30
tap_until E no_text "FIRST SHIFT" 90
until text "Rivet" 10
wait 1
shot pilot-select-all-open
key 2
until play 120
wait 2
shot rivet-run-started
ui
read player.class_def.id
quit
