# The first launch: boot card, title intro, title menu, then each menu page and back.
until text "Play" 120
shot boot-card
until text "Any key skips" 60
wait 2
shot title-intro
key SPACE
until clickable "Settings" 30
expect state title
shot title-menu
ui
click "Help"
wait 1
shot help
ui
key ESCAPE
until clickable "Achievements" 10
click "Achievements"
wait 1
shot achievements
ui
key ESCAPE
until clickable "Settings" 10
shot title-again
quit
