# A new run under the launch switches the caller passes after --, then what the game says it loaded.
# Launch with: -- --no-intro [--ball-look=today|gyro|bell|cutaway] [--models=tripo] [--stocktake=on]
# Note: ball_look defaults to cutaway, so pass --ball-look=today on the off-control drive.
# Run it once with the switch and once without: the two pictures and the two sets of rows are the proof.
until clickable "Settings" 120
until read get_node_or_null("/root/Boot") == null 30
key SPACE
until state class_select 30
tap_until E no_text "FIRST SHIFT" 90
until text "Sable" 10
key 1
until text "Rig your kit" 60
until read launch_take == null or not launch_take.busy() 30
key 1
until read not get_tree().paused 30
until play 30
wait 2
shot in-play
read tuning.option("ball_look")
read tuning.option("stocktake")
read world.activities.site("stocktake_yard") != null
meshes "ball_look"
read player.ball_position()
# Enemies and props load as the stage wakes: give it time, then count whose model files are drawn.
wait 25
meshes "enemy_"
meshes "_tripo"
shot later
quit
