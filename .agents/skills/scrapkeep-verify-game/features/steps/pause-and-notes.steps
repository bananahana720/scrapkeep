# In play: the pause menu (P), resume (Esc), and the held Tab pages.
# Launch with: -- --no-intro
until clickable "Settings" 120
until read get_node_or_null("/root/Boot") == null 30
key SPACE
until state class_select 30
tap_until E no_text "FIRST SHIFT" 90
until text "Sable" 10
key 1
until text "Rig your kit" 60
key 1
until text "Take one" 30
key 1
until read not get_tree().paused 30
wait 2
shot in-play
key P
until read get_tree().paused 10
wait 1
shot paused
ui
key ESCAPE
until read not get_tree().paused 10
shot resumed
down TAB
wait 1.5
shot tab-held
ui
up TAB
wait 1
expect read not get_tree().paused
shot tab-released
quit
