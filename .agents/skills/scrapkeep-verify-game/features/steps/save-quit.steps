# First half of save and continue: start a run, roll, then quit from the pause menu.
# Launch with VERIFY_GAME_HOME=<dir> and: -- --no-intro
until clickable "Settings" 120
until read get_node_or_null("/root/Boot") == null 30
expect no_text "Continue"
shot title-no-continue
key SPACE
until state class_select 30
tap_until E no_text "FIRST SHIFT" 90
until text "Sable" 10
key 1
until text "Rig your kit" 60
until read launch_take == null or not launch_take.busy() 30
key 1
until read not get_tree().paused 30
down W
wait 5
up W
shot before-quit
read player.ball_position()
key P
until clickable "Quit" 10
shot paused
click "Quit"
wait 1
shot quit-asked
ui
quits click "Quit"
