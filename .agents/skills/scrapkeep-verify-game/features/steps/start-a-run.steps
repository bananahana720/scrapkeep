# A new player's first run: title, prologue, pilot select, the kit pick, then rolling in stage 1.
# Launch with: -- --no-intro
until clickable "Settings" 120
until read get_node_or_null("/root/Boot") == null 30
key SPACE
until state class_select 30
shot prologue
tap_until E no_text "FIRST SHIFT" 90
until text "Sable" 10
wait 1
shot pilot-select
key 1
until text "Rig your kit" 60
expect read get_tree().paused
shot kit-pick
key 1
until text "Take one" 30
shot start-pick
key 1
until read not get_tree().paused 30
until play 30
wait 2
shot dropped-in
ui
read player.ball_position()
down W
until read player.state.velocity.length() > 3.0 15
wait 5
up W
shot after-rolling
read player.ball_position()
read run.stage
quit
