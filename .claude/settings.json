{
  "model": "opus[1m]",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "effortLevel": "high",
  "switchModelsOnFlag": false,
  "fallbackModel": [],
  "autoCompactEnabled": true,
  "subagentPromptCacheTtl": "1h",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "40"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "mcp__github__create_pull_request",
      "Bash(node scripts/crash-harvest.mjs *)",
      "Bash(node scripts/redteam/run.mjs *)",
      "Bash(node scripts/redteam/merge.mjs *)",
      "Bash(npm view *)",
      "Bash(claude plugin validate *)",
      "Bash(git merge-base *)",
      "Bash(npm run check:docs)",
      "Bash(npm run check:project)",
      "Bash(npm run check:scope)",
      "Bash(npm run check:drift)",
      "Bash(npm run check:skills)",
      "Bash(npm run sketch:lint)",
      "Bash(nvidia-smi *)",
      "Bash(nvidia-smi)",
      "Bash(journalctl *)",
      "Bash(systemctl --user is-active *)",
      "Bash(systemctl --user list-units *)",
      "Bash(lscpu)",
      "mcp__ccd_session_mgmt__list_sessions",
      "mcp__ccd_session_mgmt__list_events",
      "mcp__ccd_session_mgmt__search_session_transcripts",
      "mcp__ccd_session_mgmt__get_usage",
      "mcp__human-in-the-loop__list_tasks",
      "mcp__ccd_pr__get_status",
      "mcp__visualize__read_me",
      "mcp__ccd_session__list_start_targets"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(npm publish*)",
      "Bash(gh repo delete*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm uninstall*)"
    ]
  },
  "enabledMcpjsonServers": [
    "godot"
  ]
}
