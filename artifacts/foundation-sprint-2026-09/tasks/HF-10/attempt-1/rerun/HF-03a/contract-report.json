  "scenarios": [
    {
      "id": "M01",
      "route": "A view edits a nested attack target list. Presentation must hold a detached result; Encounter's AttackLedger is unchanged.",
      "paper_result": "PASS: table and mutation rule 2 assign one writer. S0-04 B covers scalar copies only; nested alias isolation remains unqualified. TADR-002 lines 26, 30."
    },
    {
      "id": "M02",
      "route": "An actor timer, animation callback or second autoload attempts a gameplay step.",
      "paper_result": "PASS: Encounter alone advances through its fixed callback; Session creation cannot delegate another tick authority. S0-04 A/B covers the process/timer case, not duplicate autoload prevention. TADR-002 line 26."
    },
    {
      "id": "M03",
      "route": "A movement request or obstructed attack needs physical contacts.",
      "paper_result": "PASS: Encounter requests CollisionQueries results, then commits gameplay pose/attack outcomes; Presentation renders those results. No view physics query or cosmetic target selection. This route is unexecuted here. TADR-002 lines 28\u201330."
    },
    {
      "id": "M04",
      "route": "An encounter unloads and a late result arrives.",
      "paper_result": "PASS: Session retains RunState/ProfileState, retires the old command routes and rejects results for that retired encounter. Replacement receives value initialization. Scene replacement remains unqualified by S0-04. TADR-002 line 26."
    },
    {
      "id": "M05",
      "route": "Between fights, a player swaps equipment and then asks to respec a tree without an authorized opportunity.",
      "paper_result": "PASS: Session can rebuild EffectiveBuild after a valid equipment request; it rejects the unsupported respec request. Encounter receives the replacement effective build at the authorized boundary. No residual effects or invented respec policy. TADR-002 line 32."
    },
    {
      "id": "M06",
      "route": "The same completed-level reward arrives twice, then a critical save write fails.",
      "paper_result": "PASS: Session holds one PendingTransition; Persistence uses its transaction identity and commits reward/profile/checkpoint effects together or returns SaveError. UI shows the held transition; it cannot grant rewards or call the save durable. TADR-004 lines 28\u201332. Full idempotency protocol remains HF-07."
    },
    {
      "id": "M07",
      "route": "Reload finds an older checkpoint alongside spent revival or terminal facts.",
      "paper_result": "PASS: Persistence validates lifecycle continuity and reports a compatible restore or visible refusal; Session cannot reopen the older living state. Health/placement remain gated by Q-P16. TADR-004 lines 30, 34, 40."
    },
    {
      "id": "M08",
      "route": "A catalogue reload fails, or an active saved run references an older revision.",
      "paper_result": "PASS: ContentAdmission retains the current catalogue on failed validation and preserves required pinned revisions. Session cannot switch that run's pin without an explicit successful migration. Missing IDs produce diagnostics. TADR-003 lines 29\u201333."
    },
    {
      "id": "M09",
      "route": "Focus loss occurs with held input and a prepared cast.",
      "paper_result": "PASS: InputAdapter clears physical state; Session explicitly requests Encounter cancellation and coordinates pause. Resume must not manufacture a cast. Exact ordering remains HF-04a; S0-04 C\u2013E supplies only its stated synthetic case. TADR-002 line 34."
    },
    {
      "id": "M10",
      "route": "A UI volume change or save load occurs.",
      "paper_result": "PASS: Session reads a preference request from Presentation; Persistence alone updates PreferencesRecord without rewriting DurableAggregate. A restore returns values for Session to install, never writable save-to-run aliases. TADR-004 lines 24, 34."
    },
    {
      "id": "M11",
      "route": "A globally named script, preload or scene reference reaches a foreign mutable record or imports a proof as production code.",
      "paper_result": "PASS: every form counts as an import; the table rejects unlisted owner dependencies and mutation rule 2 rejects the alias. No global bus, mutable static gameplay state or proof-to-production dependency. TADR-002 lines 24, 26, 42."
    }
  ],
  "status": "fail"
}
