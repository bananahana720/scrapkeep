+def cooling_fins(core):
+    """Keep both leaves on one copper draw outside the replaceable lattice mesh."""
+    part = Part("CoolingFins")
+    hinges = []
+    for az, el in FIN_AT:
+        pivot, across = fin(part, direction(az, el))
+        left = az < 0
+        # The pose table sets opposite angles. Point the two hinge axes so
+        # both positive displacements of the tips are away from the ball.
+        hinges.append(("Fin.L" if left else "Fin.R", pivot, -across if left else across))
+    sb._sharpen(part, angle=1.1)
+    rig = bpy.data.objects.new("CoolingFinRig", bpy.data.armatures.new("CoolingFinBones"))
+    bpy.context.collection.objects.link(rig)
+    rig.parent = core
+    mesh = part.to_object(parent=rig)
+    bpy.context.view_layer.objects.active = rig
+    rig.select_set(True)
+    bpy.ops.object.mode_set(mode="EDIT")
+    root = rig.data.edit_bones.new("FinMount")
+    root.head, root.tail = (0, 0, 0), (0, 0.08, 0)
+    for name, pivot, axis in hinges:
+        bone = rig.data.edit_bones.new(name)
+        bone.parent = root
+        bone.head = pivot
+        bone.tail = pivot + axis * 0.1
+    bpy.ops.object.mode_set(mode="OBJECT")
+    for name, pivot, _axis in hinges:
+        vertices = [v.index for v in mesh.data.vertices if v.co.x * pivot.x > 0]
+        if len(vertices) * 2 != len(mesh.data.vertices) or not vertices:
+            raise ValueError("expected one half of the fin pair on " + name)
+        mesh.vertex_groups.new(name=name).add(vertices, 1.0, "REPLACE")
+    mesh.modifiers.new("Cooling fin hinges", "ARMATURE").object = rig
+    return mesh


