#!/usr/bin/env bash
# Run the Scrapkeep sketch launcher from anywhere.
#   scrapkeep              list what is playable
#   scrapkeep mobility     play it
#   scrapkeep test         headless checks across every worktree
#
# Tracked copy of the wrapper (audit A19: the untracked ~/.local/bin/scrapkeep
# had no source of truth in the repo). SCRAPKEEP_ROOT behaviour is unchanged:
# it still names the checkout to run against, not this script's own location,
# so ~/.local/bin/scrapkeep can keep pointing at $HOME/Projects/scrapkeep
# while a worktree copy of this file still runs against that same checkout.
set -uo pipefail

REPO="${SCRAPKEEP_ROOT:-$HOME/Projects/scrapkeep}"

if [ -f "$REPO/scripts/play.mjs" ]; then
  exec node "$REPO/scripts/play.mjs" "$@"
else
  echo "scrapkeep: no launcher at $REPO/scripts/play.mjs" >&2
  echo "Set SCRAPKEEP_ROOT if the repo lives somewhere else." >&2
  exit 2
fi
