#!/usr/bin/env python3
"""`blender` for cloud sessions: runs recipes on the bpy 5.2.2 wheel, which has no GUI binary.

Accepts the command lines the recipes document:
  blender -b [--factory-startup] [-t N] [--python-exit-code N] [file.blend] -P recipe.py [-- args]
  blender --version
Recipes read their own arguments after `--` from sys.argv, as under the real binary.
"""
import os
import runpy
import sys
import traceback


def usage(message):
    print("scripts/cloud/blender: " + message, file=sys.stderr)
    sys.exit(2)


def main(argv):
    own, rest = (argv[: argv.index("--")], argv[argv.index("--"):]) if "--" in argv else (argv, [])
    threads = None
    exit_code = 0
    steps = []
    blend = None
    i = 0
    while i < len(own):
        arg = own[i]
        if arg in ("-b", "--background", "--factory-startup", "--disable-autoexec", "-noaudio"):
            pass
        elif arg in ("-v", "--version"):
            import bpy

            print("Blender " + bpy.app.version_string)
            print("\tbuild hash: " + bpy.app.build_hash.decode())
            return 0
        elif arg in ("-t", "--threads"):
            i += 1
            threads = int(own[i])
        elif arg == "--python-exit-code":
            i += 1
            exit_code = int(own[i])
        elif arg in ("-P", "--python"):
            i += 1
            steps.append(("file", own[i]))
        elif arg == "--python-expr":
            i += 1
            steps.append(("expr", own[i]))
        elif arg.endswith(".blend") and not arg.startswith("-"):
            blend = arg
        else:
            usage("unsupported argument " + arg)
        i += 1
    if not steps:
        usage("nothing to run; pass -P <recipe.py>")

    import bpy

    if blend:
        bpy.ops.wm.open_mainfile(filepath=os.path.abspath(blend))
    if threads:
        for scene in bpy.data.scenes:
            scene.render.threads_mode = "FIXED"
            scene.render.threads = threads

    for kind, value in steps:
        sys.argv = ["blender"] + own + rest
        try:
            if kind == "file":
                runpy.run_path(value, run_name="__main__")
            else:
                exec(compile(value, "<python-expr>", "exec"), {"__name__": "__main__", "bpy": bpy})
        except SystemExit as stop:
            if stop.code not in (None, 0):
                return stop.code if isinstance(stop.code, int) else 1
        except BaseException:
            traceback.print_exc()
            if exit_code:
                return exit_code
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
