#!/usr/bin/env bash
# The music thread's repeating steps as one allow-listable command, so each runs as a
# single plain call with no cd, pipe or heredoc (Andrew, 2026-10-17: no allow-once prompts).
#
#   scripts/music/mx spice [cue ...]            remix and master the current picks (spice.py)
#   scripts/music/mx gapfill [tune id ...]      render, split and master the place and moment twists
#   scripts/music/mx master <in> <out> [args]   evolve.py master
#   scripts/music/mx overnight [args]           overnight.py <render folder> <score dir> [args]
#   scripts/music/mx check [args]               check_mix.py from the score dir
#   scripts/music/mx py <script.py> [args]      a scratch script under /tmp/claude-1000, ACE-Step venv, -I
#   scripts/music/mx mp3 <in> <out.mp3>         160 kb/s encode
#   scripts/music/mx godot-test <name>          sketches/core-loop/tests/<name>.gd, headless
#   scripts/music/mx godot-script <file.gd>     a scratch Godot script against the sketch project
#   scripts/music/mx lint                       npm run sketch:lint
#   scripts/music/mx audio-gate [args]          node scripts/audio-gate.mjs
#   scripts/music/mx stems-sync [args]          copy the packed Oggs STEMS.sha256 lists into this worktree
#   scripts/music/mx stem-hashes [args]         rewrite assets/music_ace/STEMS.sha256 after any pack
#   scripts/music/mx lyria [args]               hybrid stem-context Gemini -> Lyria 3.5 -> 3-stem pack pipeline
#   scripts/music/mx commit <msg file> <path>...  stage the paths and commit with the message file
#   scripts/music/mx push                       push this thread's branch
#   scripts/music/mx merge-main                 fetch and merge origin/main, no edit
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
sound="$repo/sketches/core-loop/design-v3/sound"
py="$HOME/.local/share/ACE-Step-1.5/.venv/bin/python"
renders="${MX_RENDERS:-$HOME/Music/Scrapkeep-sound-direction/sound-bible-2026-10-16}"
score="${MX_SCORE:-/tmp/claude-1000/-home-andrew-Projects-scrapkeep--claude-worktrees-interesting-swartz-495db0/e4a9c0be-489e-490c-9545-2d0059163b8a/scratchpad/score}"
branch="claude/project-thread-d1uvzh"

if [ "$#" -lt 1 ]; then
    sed -n '2,21p' "${BASH_SOURCE[0]}" >&2
    exit 2
fi
step="$1"
shift

case "$step" in
    spice)
        nice -n 10 "$py" -I "$sound/spice.py" "$renders" "$@"
        ;;
    gapfill)
        nice -n 10 "$py" -I "$sound/gapfill.py" "$renders" "$@"
        ;;
    master)
        nice -n 10 "$py" -I "$sound/evolve.py" master "$@"
        ;;
    overnight)
        nice -n 10 "$py" -I "$sound/overnight.py" "$renders" "$score" "$@"
        ;;
    check)
        "$py" -I "$score/check_mix.py" "$@"
        ;;
    py)
        case "$1" in
            /tmp/claude-1000/*.py) ;;
            *) echo "mx py: only scratch scripts under /tmp/claude-1000" >&2; exit 2 ;;
        esac
        nice -n 10 "$py" -I "$@"
        ;;
    mp3)
        ffmpeg -v error -y -i "$1" -b:a 160k "$2"
        ;;
    godot-test)
        timeout 600 godot --headless --path "$repo/sketches/core-loop" -s "tests/$1.gd"
        ;;
    godot-script)
        timeout 600 godot --headless --path "$repo/sketches/core-loop" -s "$1"
        ;;
    lint)
        npm --prefix "$repo" run -s sketch:lint
        ;;
    audio-gate)
        node "$repo/scripts/audio-gate.mjs" "$@"
        ;;
    stem-hashes)
        node "$repo/scripts/audio-gate.mjs" --write-stem-hashes "$@"
        ;;
    stems-sync)
        node "$repo/scripts/stems-sync.mjs" "$@"
        ;;
    lyria)
        node "$repo/scripts/music/lyria-tune.mjs" "$@"
        ;;
    commit)
        msg="$1"
        shift
        git -C "$repo" add -- "$@"
        git -C "$repo" commit -q -F "$msg"
        git -C "$repo" log --oneline -1
        ;;
    push)
        git -C "$repo" push -q -u origin "$branch"
        git -C "$repo" log --oneline -1
        ;;
    merge-main)
        git -C "$repo" fetch -q origin main
        git -C "$repo" merge -q --no-edit origin/main
        git -C "$repo" log --oneline -1
        ;;
    *)
        echo "mx: unknown step '$step'" >&2
        exit 2
        ;;
esac
