.godot/
*.import
# ACE music (tools/ace/package_music.py): the Oggs are local; manifest.json is committed.
assets/music_ace/**/*.ogg
assets/music_ace/.gdignore
!assets/textures/*.webp.import
# Event-set WAVs load as PCM (compress/mode=0): the bank decodes their 16-bit data, which QOA hides.
!assets/audio/event_set/*.wav.import
# Pilot animation GLBs keep their _loop clip names: name suffixes off, loop clips set (PE round 2, 2026-10-11).
!assets/models/pilot_*_anim.glb.import
# Park dressing kit GLBs use our own LODs: Godot's automatic mesh LOD generation is off (Dressing lane, 2026-10-19).
!assets/models/park/props/*/*.glb.import
# Local evidence (tools write here; the repo-root artifacts/local/ rule does not reach this folder).
artifacts/local/
.mcp/
