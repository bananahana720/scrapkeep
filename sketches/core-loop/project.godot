config_version=5

[application]

config/name="Scrapkeep"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/core-loop"
run/main_scene="res://src/boot/boot.tscn"
run/flush_stdout_on_print=true
config/icon="res://assets/app/scrapkeep_icon.svg"
boot_splash/bg_color=Color(0.1411765, 0.1647059, 0.1568627, 1)
boot_splash/image="res://assets/app/scrapkeep_splash.png"
boot_splash/use_filter=true
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/ui/scrapkeep_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=90

[rendering]

anti_aliasing/quality/msaa_3d=2

[shader_globals]

threat_fill_scale={
"type": "float",
"value": 1.0
}
