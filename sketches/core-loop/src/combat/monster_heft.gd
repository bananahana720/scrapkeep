extends RefCounted

# The heft a pilot must be strictly above to count as a monster build at a stage's Warden or boss:
# the library's top-bucket maximum for that fight, read from data/challenge/monster_heft.json
# (generated by tools/monster_heft_gen.gd). A missing file, stage or fight is INF, so nobody is a monster
# there (coordinator ruling (B) on #222, 21 Oct).

const PATH := "res://data/challenge/monster_heft.json"
static var _doc = null


# The park Warden of this stage (judged at its arrival, see tools/monster_heft_gen.gd fights).
static func threshold_for_stage(stage: int) -> float:
	return _number("wardens", str(stage))


# The Waking arena's own entrance (stage 4) and the Mind arena's (stage 6).
static func waking_threshold() -> float:
	return _number("waking")


static func mind_threshold() -> float:
	return _number("mind")


static func _number(key: String, sub := "") -> float:
	if _doc == null:
		_doc = {}
		var parsed = JSON.parse_string(FileAccess.get_file_as_string(PATH)) if FileAccess.file_exists(PATH) else null
		if parsed is Dictionary:
			_doc = parsed
	var value = _doc.get(key)
	if sub != "":
		value = value.get(sub) if value is Dictionary else null
	return float(value) if value is float or value is int else INF
