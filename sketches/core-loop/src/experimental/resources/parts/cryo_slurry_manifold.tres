[resource]
script = ExtResource("1_part")
id = &"cryo_slurry_manifold"
display_name = "Cryo-Slurry Manifold"
maker = &"spillway_works"
slot = 2
rarity = &"fleet_grade"
trigger = &"on_prop_rupture"
emits_tags = Array[StringName]([&"coolant_brittle"])
