[resource]
script = ExtResource("1_part")
id = &"hoard_coil_ballast"
display_name = "Hoard-Coil Ballast"
maker = &"moss"
slot = 2
rarity = &"field_kit"
trigger = &"on_scrap_pickup"
emits_tags = Array[StringName]([&"magnetic"])
consumes_tags = Array[StringName]([])
