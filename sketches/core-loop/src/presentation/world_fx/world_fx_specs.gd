static func colour(name: String) -> Color:
	if KIT.has(name):
		return KIT[name]
	var named: Dictionary = (Palette as Script).get_script_constant_map()
	return named.get(name, Palette.SAND)


static func colour_names(id: String) -> Array:
	var c = SPECS[id].get("colour", "SAND")
	return c if c is Array else [c]
