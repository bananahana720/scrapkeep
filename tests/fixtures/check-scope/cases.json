[
  {
    "name": "sketch claims Godot files and Markdown under sketches/",
    "paths": [
      "sketches/core-loop/project.godot",
      "sketches/core-loop/src/game.gd",
      "sketches/core-loop/README.md"
    ],
    "scope": "sketch",
    "commands": ["npm run sketch:smoke"],
    "noBuild": true,
    "status": 0
  },
  {
    "name": "documentation-only",
    "paths": ["docs/design/loops.md", "adr/TADR-009.md", "README.md"],
    "scope": "documentation-only",
    "commands": ["npm run check:docs", "npm run check:project"],
    "noBuild": true,
    "status": 0
  },
  {
    "name": "browser-proof with UI paths",
    "paths": ["src/orchard/simulation.js", "orchard.html"],
    "scope": "browser-proof",
    "commands": [
      "npm run verify",
      "CONTRIBUTING.md Verification browser checks"
    ],
    "noBuild": false,
    "status": 0
  },
  {
    "name": "tooling",
    "paths": [
      "scripts/check-docs.mjs",
      "tests/check-docs.test.js",
      "package.json"
    ],
    "scope": "tooling",
    "commands": ["npm run verify"],
    "noBuild": false,
    "status": 0
  },
  {
    "name": "native",
    "paths": ["game/project.godot", "game/main.tscn", "game/player.gd"],
    "scope": "native",
    "commands": ["npm run check:godot"],
    "noBuild": false,
    "status": 0
  },
  {
    "name": "configuration",
    "paths": [".claude/agents/scrapkeep-writer.md", ".gitignore"],
    "scope": "configuration",
    "commands": ["npm run check:docs", "scenario review"],
    "noBuild": true,
    "status": 0
  },
  {
    "name": "mixed refused under --no-build",
    "paths": ["docs/design/loops.md", "src/orchard/scene.js"],
    "scope": "mixed",
    "commands": ["npm run check:docs", "npm run verify"],
    "noBuild": true,
    "status": 1
  },
  {
    "name": "instruction files as configuration",
    "paths": [
      "AGENTS.md",
      "CLAUDE.md",
      "GEMINI.md",
      ".agents/hooks.json",
      ".agents/rules/godot-core-loop.md"
    ],
    "scope": "configuration",
    "commands": ["npm run check:docs", "scenario review"],
    "noBuild": true,
    "status": 0
  },
  {
    "name": "other",
    "paths": ["Makefile"],
    "scope": "other",
    "commands": ["npm run verify"],
    "noBuild": false,
    "status": 0
  },
  {
    "name": "empty",
    "paths": [],
    "scope": "empty",
    "commands": [],
    "noBuild": true,
    "status": 0
  }
]
